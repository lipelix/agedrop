# Usually not needed: infra/bootstrap.sh asks for the Cloudflare tokens and takes the GitHub one from gh.
# Copy to env.auto.tfvars (gitignored) and fill in, then: tofu login && tofu init && tofu apply
cloudflare_api_token = "CLOUDFLARE_API_TOKEN" // https://dash.cloudflare.com/profile/api-tokens — personal account: Zone DNS Edit + Zone Single Redirect Edit (agedrop.dev) + Account Cloudflare Pages Edit
pages_deploy_token   = "PAGES_DEPLOY_TOKEN"   // same page — Account Cloudflare Pages Edit only; becomes the repo secret for CI
github_token         = "GITHUB_TOKEN"         // https://github.com/settings/personal-access-tokens — lipelix/agedrop only: Secrets + Variables read/write
